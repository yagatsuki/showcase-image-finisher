<Application x:Class="ShowcaseImageFinisher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- No StartupUri: App.OnStartup applies the saved theme first
         (palette + optionally the Styles dictionary), then creates
         the main window, so the Standard theme can start with no
         custom styles loaded at all. The dictionaries below are the
         pre-startup default (Dark) and are replaced by ThemeManager. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml"/>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
