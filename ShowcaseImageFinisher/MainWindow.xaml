<Window x:Class="ShowcaseImageFinisher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Showcase Image Finisher ― 背景除去 → トリミング → 出力"
        Width="1120" Height="580" MinWidth="620" MinHeight="430"
        Background="{DynamicResource BgBrush}" FontFamily="Segoe UI, Yu Gothic UI" FontSize="13">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition x:Name="LogRow" Height="76"/>
        </Grid.RowDefinitions>

        <!-- Drop area: click to pick files, or drop files/folders -->
        <Grid Grid.Row="0" x:Name="DropArea" AllowDrop="True"
              DragOver="DropArea_DragOver" DragLeave="DropArea_DragLeave"
              Drop="DropArea_Drop" MouseLeftButtonUp="DropArea_Click"
              Background="Transparent" Cursor="Hand">
            <Rectangle x:Name="DropRect" Stroke="{DynamicResource DropStrokeBrush}" StrokeThickness="2"
                       StrokeDashArray="5 3" Fill="{DynamicResource DropFillBrush}" RadiusX="10" RadiusY="10"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        IsHitTestVisible="False">
                <TextBlock Text="ここに画像ファイルをドロップ" FontSize="15"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="クリックでも選択できます（複数可・フォルダをドロップすると中の画像を読み込みます）"
                           Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" FontSize="11"/>
            </StackPanel>
        </Grid>

        <!-- File list + preview -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition x:Name="PreviewColumn" Width="252" MinWidth="0"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ListView x:Name="FileList" Grid.Row="0"
                      SelectionChanged="FileList_SelectionChanged"
                      MouseDoubleClick="FileList_MouseDoubleClick"
                      KeyDown="FileList_KeyDown">
                <ListView.ContextMenu>
                    <ContextMenu Opened="FileListContextMenu_Opened">
                        <MenuItem x:Name="CopyRowsItem" Header="選択行をコピー"
                                  InputGestureText="Ctrl+C"
                                  Click="CopyRows_Click"/>
                        <MenuItem x:Name="CopyNamesItem" Header="ファイル名をコピー"
                                  Click="CopyNames_Click"/>
                        <MenuItem x:Name="CopyOutputItem" Header="出力ファイルのパスをコピー"
                                  Click="CopyOutputPaths_Click"/>
                        <MenuItem x:Name="CopyInputItem" Header="入力ファイルのパスをコピー"
                                  Click="CopyInputPaths_Click"/>
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView>
                        <GridViewColumn x:Name="NameColumn" Header="ファイル名" Width="340">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FileName}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding FullPath}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="SizeColumn" Header="サイズ" Width="84"
                                        DisplayMemberBinding="{Binding SizeText}"/>
                        <GridViewColumn x:Name="StatusColumn" Header="状態" Width="360">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Status}"
                                               TextWrapping="Wrap"
                                               ToolTip="{Binding Status}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="選択を削除" Padding="10,3" Click="RemoveSelected_Click"/>
                <Button Content="全てクリア" Padding="10,3" Margin="8,0,0,0" Click="ClearAll_Click"/>
                <Button Content="開く" Padding="10,3" Margin="8,0,0,0" Click="OpenSelected_Click"/>
                <TextBlock x:Name="CountText" Margin="14,4,0,0" Foreground="{DynamicResource SubTextBrush}"/>
                <CheckBox x:Name="PreviewCheck" Content="プレビュー"
                          Margin="16,0,0,0" VerticalAlignment="Center"
                          Checked="PreviewCheck_Changed" Unchecked="PreviewCheck_Changed"/>
            </StackPanel>
            </Grid>

            <GridSplitter x:Name="PreviewSplitter" Grid.Column="1" Width="6"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{DynamicResource SplitterBrush}" ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- Preview card -->
            <Border x:Name="PreviewCard" Grid.Column="2" Margin="4,0,0,0"
                    Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="プレビュー" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <RadioButton x:Name="PreviewBeforeRadio" Content="元画像" GroupName="PreviewMode"
                                     Margin="12,0,0,0" VerticalAlignment="Center"
                                     Checked="PreviewMode_Changed"/>
                        <RadioButton x:Name="PreviewAfterRadio" Content="処理後" GroupName="PreviewMode"
                                     Margin="8,0,0,0" VerticalAlignment="Center" IsEnabled="False"
                                     Checked="PreviewMode_Changed"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="{DynamicResource CheckerBrush}" CornerRadius="6"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Image x:Name="PreviewImage" Stretch="Uniform" Margin="4"/>
                    </Border>
                    <TextBlock Grid.Row="2" x:Name="PreviewInfo" Margin="0,6,0,0" FontSize="11"
                               Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap"
                               Text="ファイルを選ぶとここに表示されます"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Options: WrapPanel rows, so anything that does not fit wraps
             onto the next line instead of being clipped off-screen. -->
        <Border Grid.Row="2" Margin="0,8,0,0" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <StackPanel Margin="8,6,8,8">
                <TextBlock Text="設定" FontWeight="SemiBold" Margin="2,0,0,4"/>
                <WrapPanel>
                    <TextBlock Text="背景除去モデル:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ModelCombo" Width="200" Margin="6,2"/>
                    <TextBlock Text="出力形式:" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <ComboBox x:Name="FormatCombo" Width="140" Margin="6,2">
                        <ComboBoxItem Content="PNG" Tag="Png"/>
                        <ComboBoxItem Content="WebP" Tag="Webp"/>
                        <ComboBoxItem Content="JPEG XL" Tag="JpegXl"/>
                    </ComboBox>
                    <TextBlock Text="テーマ:" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <ComboBox x:Name="ThemeCombo" Width="104" Margin="6,2"
                              SelectionChanged="ThemeCombo_SelectionChanged">
                        <ComboBoxItem Content="ダーク" Tag="Dark"/>
                        <ComboBoxItem Content="ライト" Tag="Light"/>
                        <ComboBoxItem Content="標準" Tag="Standard"/>
                    </ComboBox>
                    <TextBlock Text="リスト文字:" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <ComboBox x:Name="ListFontCombo" Width="72" Margin="6,2"
                              SelectionChanged="ListFontCombo_SelectionChanged">
                        <ComboBoxItem Content="小" Tag="11"/>
                        <ComboBoxItem Content="標準" Tag="12"/>
                        <ComboBoxItem Content="大" Tag="14"/>
                        <ComboBoxItem Content="特大" Tag="16"/>
                    </ComboBox>
                    <TextBlock Text="接尾辞:" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBox x:Name="SuffixBox" Text="_finished" Width="90" Margin="6,2" VerticalContentAlignment="Center"/>
                </WrapPanel>
                <WrapPanel Margin="0,4,0,0">
                    <TextBlock Text="出力先:" VerticalAlignment="Center"/>
                    <RadioButton x:Name="OutSameRadio" Content="入力と同じフォルダ" IsChecked="True" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    <RadioButton x:Name="OutDirRadio" Content="指定フォルダ" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBox x:Name="OutDirBox" Width="290" Margin="8,2" VerticalContentAlignment="Center"/>
                    <Button Content="参照..." Padding="10,2" Margin="2" Click="BrowseOutDir_Click"/>
                    <CheckBox x:Name="OverwriteCheck" Content="同名ファイルを上書き" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </WrapPanel>
                <WrapPanel Margin="0,4,0,0">
                    <CheckBox x:Name="DefringeCheck" Content="輪郭のフリンジ除去" VerticalAlignment="Center"/>
                    <CheckBox x:Name="LargestCheck" Content="一番大きい被写体だけに合わせる" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    <TextBlock Text="余白(px):" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    <TextBox x:Name="PaddingBox" Text="0" Width="44" Margin="6,2" VerticalContentAlignment="Center"/>
                    <CheckBox x:Name="SizePriorityCheck" Content="容量優先（非可逆）" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </WrapPanel>
                <TextBlock Foreground="{DynamicResource SubTextBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="容量優先オフ＝可逆で出力。オン＝PNGは256色へ量子化、WebPは画質90の非可逆、JPEG XLはdistance 1.0の非可逆になり、容量が大幅に減ります（画質はわずかに低下します）"/>
                <TextBlock x:Name="JxlNote" Foreground="{DynamicResource SubTextBrush}" FontSize="11"
                           Margin="0,4,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="LiqNote" Foreground="{DynamicResource SubTextBrush}" FontSize="11"
                           Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Run -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="RunButton" Content="実行" Padding="26,6" Style="{DynamicResource PrimaryButton}"
                    FontSize="14" Click="Run_Click"/>
            <Button Grid.Column="1" x:Name="CancelButton" Content="中止" Padding="16,6"
                    Margin="8,0,0,0" IsEnabled="False" Click="Cancel_Click"/>
            <ProgressBar Grid.Column="2" x:Name="Bar" Height="16" Margin="12,0,0,0"
                         VerticalAlignment="Center"/>
        </Grid>

        <!-- Log height drag strip. A manual drag (not GridSplitter):
             the rows between the main area and the log are Auto-sized,
             which GridSplitter would resize along with the log. -->
        <Border Grid.Row="4" x:Name="LogSplitter" Height="6"
                VerticalAlignment="Center" Cursor="SizeNS"
                Background="{DynamicResource LineBrush}"
                ToolTip="ドラッグでログの高さを変更"
                MouseLeftButtonDown="LogSplitter_Down"
                MouseMove="LogSplitter_Move"
                MouseLeftButtonUp="LogSplitter_Up"/>

        <!-- Log -->
        <ListBox Grid.Row="5" x:Name="LogList"
                 FontFamily="Consolas, Yu Gothic UI" FontSize="12"
                 KeyDown="LogList_KeyDown">
            <ListBox.ContextMenu>
                <ContextMenu x:Name="LogMenu" Opened="LogMenu_Opened">
                    <MenuItem x:Name="LogCopyItem" Header="選択行をコピー"
                              InputGestureText="Ctrl+C" Click="LogCopy_Click"/>
                    <MenuItem x:Name="LogCopyAllItem" Header="すべてコピー"
                              Click="LogCopyAll_Click"/>
                    <Separator/>
                    <MenuItem x:Name="LogClearItem" Header="ログをクリア"
                              Click="LogClear_Click"/>
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>
    </Grid>
</Window>
