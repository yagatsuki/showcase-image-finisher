<Window x:Class="ShowcaseImageFinisher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Showcase Image Finisher ― 背景除去 → トリミング → 可逆出力"
        Width="860" Height="580" MinWidth="620" MinHeight="430"
        Background="#161E2E" FontFamily="Segoe UI, Yu Gothic UI" FontSize="13">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="76"/>
        </Grid.RowDefinitions>

        <!-- Drop area: click to pick files, or drop files/folders -->
        <Grid Grid.Row="0" x:Name="DropArea" AllowDrop="True"
              DragOver="DropArea_DragOver" DragLeave="DropArea_DragLeave"
              Drop="DropArea_Drop" MouseLeftButtonUp="DropArea_Click"
              Background="Transparent" Cursor="Hand">
            <Rectangle x:Name="DropRect" Stroke="#46618C" StrokeThickness="2"
                       StrokeDashArray="5 3" Fill="#1B2740" RadiusX="10" RadiusY="10"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        IsHitTestVisible="False">
                <TextBlock Text="ここに画像ファイルをドロップ" FontSize="15"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="クリックでも選択できます（複数可・フォルダをドロップすると中の画像を読み込みます）"
                           Foreground="#94A3B8" HorizontalAlignment="Center" FontSize="11"/>
            </StackPanel>
        </Grid>

        <!-- File list -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ListView x:Name="FileList" Grid.Row="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="ファイル名" Width="340"
                                        DisplayMemberBinding="{Binding FileName}"/>
                        <GridViewColumn Header="サイズ" Width="84"
                                        DisplayMemberBinding="{Binding SizeText}"/>
                        <GridViewColumn Header="状態" Width="360"
                                        DisplayMemberBinding="{Binding Status}"/>
                    </GridView>
                </ListView.View>
            </ListView>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="選択を削除" Padding="10,3" Click="RemoveSelected_Click"/>
                <Button Content="全てクリア" Padding="10,3" Margin="8,0,0,0" Click="ClearAll_Click"/>
                <TextBlock x:Name="CountText" Margin="14,4,0,0" Foreground="#94A3B8"/>
            </StackPanel>
        </Grid>

        <!-- Options: WrapPanel rows, so anything that does not fit wraps
             onto the next line instead of being clipped off-screen. -->
        <Border Grid.Row="2" Margin="0,8,0,0" Background="#1C2942"
                BorderBrush="#334155" BorderThickness="1" CornerRadius="8">
            <StackPanel Margin="8,6,8,8">
                <TextBlock Text="設定" FontWeight="SemiBold" Margin="2,0,0,4"/>
                <WrapPanel>
                    <TextBlock Text="背景除去モデル:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ModelCombo" Width="200" Margin="6,2"/>
                    <TextBlock Text="出力形式:" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <ComboBox x:Name="FormatCombo" Width="140" Margin="6,2">
                        <ComboBoxItem Content="PNG（可逆）" Tag="Png"/>
                        <ComboBoxItem Content="WebP（可逆）" Tag="Webp"/>
                        <ComboBoxItem Content="JPEG XL（可逆）" Tag="JpegXl"/>
                    </ComboBox>
                    <TextBlock Text="接尾辞:" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBox x:Name="SuffixBox" Text="_finished" Width="90" Margin="6,2" VerticalContentAlignment="Center"/>
                </WrapPanel>
                <WrapPanel Margin="0,4,0,0">
                    <TextBlock Text="出力先:" VerticalAlignment="Center"/>
                    <RadioButton x:Name="OutSameRadio" Content="入力と同じフォルダ" IsChecked="True" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    <RadioButton x:Name="OutDirRadio" Content="指定フォルダ" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBox x:Name="OutDirBox" Width="290" Margin="8,2" VerticalContentAlignment="Center"/>
                    <Button Content="参照..." Padding="10,2" Margin="2" Click="BrowseOutDir_Click"/>
                    <CheckBox x:Name="OverwriteCheck" Content="同名ファイルを上書き" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </WrapPanel>
                <TextBlock x:Name="JxlNote" Foreground="#94A3B8" FontSize="11"
                           Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Run -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="RunButton" Content="実行" Padding="26,6" Style="{StaticResource PrimaryButton}"
                    FontSize="14" Click="Run_Click"/>
            <Button Grid.Column="1" x:Name="CancelButton" Content="中止" Padding="16,6"
                    Margin="8,0,0,0" IsEnabled="False" Click="Cancel_Click"/>
            <ProgressBar Grid.Column="2" x:Name="Bar" Height="16" Margin="12,0,0,0"
                         VerticalAlignment="Center"/>
        </Grid>

        <!-- Log -->
        <ListBox Grid.Row="4" x:Name="LogList" Margin="0,8,0,0"
                 FontFamily="Consolas, Yu Gothic UI" FontSize="12"/>
    </Grid>
</Window>
