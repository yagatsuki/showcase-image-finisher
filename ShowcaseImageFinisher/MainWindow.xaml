<Window x:Class="ShowcaseImageFinisher.MainWindow"
        Icon="{StaticResource AppIcon}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Showcase Image Finisher ― 背景除去 → トリミング → 可逆出力"
        Width="900" Height="620" MinWidth="720" MinHeight="470">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="96"/>
        </Grid.RowDefinitions>

        <!-- Drop area: click to pick files, or drop files/folders -->
        <Grid Grid.Row="0" x:Name="DropArea" AllowDrop="True"
              DragOver="DropArea_DragOver" DragLeave="DropArea_DragLeave"
              Drop="DropArea_Drop" MouseLeftButtonUp="DropArea_Click"
              Background="Transparent" Cursor="Hand">
            <Rectangle x:Name="DropRect" Stroke="#888" StrokeThickness="2"
                       StrokeDashArray="5 3" Fill="#10888888" RadiusX="6" RadiusY="6"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        IsHitTestVisible="False">
                <TextBlock Text="ここに画像ファイルをドロップ" FontSize="16"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="クリックでも選択できます（複数可・フォルダをドロップすると中の画像を読み込みます）"
                           Foreground="Gray" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- File list -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ListView x:Name="FileList" Grid.Row="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="ファイル名" Width="380"
                                        DisplayMemberBinding="{Binding FileName}"/>
                        <GridViewColumn Header="サイズ" Width="90"
                                        DisplayMemberBinding="{Binding SizeText}"/>
                        <GridViewColumn Header="状態" Width="400"
                                        DisplayMemberBinding="{Binding Status}"/>
                    </GridView>
                </ListView.View>
            </ListView>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="選択を削除" Padding="10,3" Click="RemoveSelected_Click"/>
                <Button Content="全てクリア" Padding="10,3" Margin="8,0,0,0" Click="ClearAll_Click"/>
                <TextBlock x:Name="CountText" Margin="14,4,0,0" Foreground="Gray"/>
            </StackPanel>
        </Grid>

        <!-- Options -->
        <GroupBox Grid.Row="2" Header="設定" Margin="0,8,0,0">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="背景除去モデル:" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ModelCombo" Margin="6,2"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="出力形式:" VerticalAlignment="Center" Margin="14,0,0,0"/>
                <ComboBox Grid.Row="0" Grid.Column="3" x:Name="FormatCombo" Margin="6,2">
                    <ComboBoxItem Content="PNG（可逆）" Tag="Png"/>
                    <ComboBoxItem Content="WebP（可逆）" Tag="Webp"/>
                    <ComboBoxItem Content="JPEG XL（可逆）" Tag="JpegXl"/>
                </ComboBox>
                <TextBlock Grid.Row="0" Grid.Column="4" Text="接尾辞:" VerticalAlignment="Center" Margin="14,0,0,0"/>
                <TextBox Grid.Row="0" Grid.Column="5" x:Name="SuffixBox" Text="_finished" Margin="6,2" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="出力先:" VerticalAlignment="Center" Margin="0,6,0,0"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5" Orientation="Horizontal" Margin="6,6,0,0">
                    <RadioButton x:Name="OutSameRadio" Content="入力と同じフォルダ" IsChecked="True" VerticalAlignment="Center"/>
                    <RadioButton x:Name="OutDirRadio" Content="指定フォルダ" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="OutDirBox" Width="380" Margin="8,0,0,0" VerticalContentAlignment="Center"/>
                    <Button Content="参照..." Padding="10,2" Margin="6,0,0,0" Click="BrowseOutDir_Click"/>
                    <CheckBox x:Name="OverwriteCheck" Content="同名ファイルを上書き" Margin="16,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="6" x:Name="JxlNote"
                           Foreground="Gray" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </Grid>
        </GroupBox>

        <!-- Run -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="RunButton" Content="実行" Padding="26,6"
                    FontSize="14" Click="Run_Click"/>
            <Button Grid.Column="1" x:Name="CancelButton" Content="中止" Padding="16,6"
                    Margin="8,0,0,0" IsEnabled="False" Click="Cancel_Click"/>
            <ProgressBar Grid.Column="2" x:Name="Bar" Height="16" Margin="12,0,0,0"
                         VerticalAlignment="Center"/>
        </Grid>

        <!-- Log -->
        <ListBox Grid.Row="4" x:Name="LogList" Margin="0,8,0,0"
                 FontFamily="Consolas, Yu Gothic UI" FontSize="12"/>
    </Grid>
</Window>
