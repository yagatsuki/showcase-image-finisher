<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- Pin the RID so native dependencies (libSkiaSharp, onnxruntime)
         are copied flat next to the exe instead of runtimes\ subfolders.
         The app then keeps working even if the output folder is copied
         around loosely. On ARM64 Windows the x64 build runs emulated. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <!-- Allows building this Windows project on non-Windows machines too;
         harmless when building in Visual Studio on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>ShowcaseImageFinisher</AssemblyName>
    <RootNamespace>ShowcaseImageFinisher</RootNamespace>
    <Version>1.0.0</Version>
    <Description>商品写真の仕上げツール: 背景除去（ONNX / rembg と同じモデル）→ 透明余白トリミング → 可逆PNG / WebP / JPEG XL 出力</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.0" />
  </ItemGroup>

</Project>
