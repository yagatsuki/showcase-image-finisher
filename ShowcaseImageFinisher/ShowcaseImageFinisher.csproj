<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- No RID pin here: the plain build stays architecture-neutral and
         runs natively on both x64 and ARM64 Windows. For a flat,
         copy-friendly folder use a publish profile (win-x64 / win-arm64)
         from Properties/PublishProfiles. -->
    <!-- Explorer/taskbar exe icon: used automatically when app.ico is
         placed in this project folder (binary, distributed separately). -->
    <ApplicationIcon Condition="Exists('app.ico')">app.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <!-- Allows building this Windows project on non-Windows machines too;
         harmless when building in Visual Studio on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>ShowcaseImageFinisher</AssemblyName>
    <RootNamespace>ShowcaseImageFinisher</RootNamespace>
    <Version>1.0.0</Version>
    <Description>商品写真の仕上げツール: 背景除去（ONNX / rembg と同じモデル）→ 透明余白トリミング → 可逆PNG / WebP / JPEG XL 出力</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.0" />
  </ItemGroup>

</Project>
