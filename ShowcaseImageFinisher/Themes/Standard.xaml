<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Standard palette: the original design before any custom theme
         (plain default WPF gray). The Styles dictionary is not loaded
         with this palette, so controls also use default templates. -->
    <SolidColorBrush x:Key="BgBrush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#ABADB3"/>
    <SolidColorBrush x:Key="TextBrush" Color="#000000"/>
    <SolidColorBrush x:Key="SubTextBrush" Color="#3F3F3F"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0078D7"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#429CE3"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#005A9E"/>
    <SolidColorBrush x:Key="LogBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LogTextBrush" Color="#000000"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#E5F1FB"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#CCE8FF"/>
    <SolidColorBrush x:Key="ComboHoverBrush" Color="#E5F1FB"/>
    <SolidColorBrush x:Key="HeaderBrush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="HeaderTextBrush" Color="#000000"/>
    <SolidColorBrush x:Key="HeaderHoverBrush" Color="#E5F1FB"/>
    <SolidColorBrush x:Key="HeaderHoverTextBrush" Color="#000000"/>
    <SolidColorBrush x:Key="HeaderPressedBrush" Color="#CCE8FF"/>
    <SolidColorBrush x:Key="ListHoverBrush" Color="#E5F1FB"/>
    <SolidColorBrush x:Key="ListSelectedBrush" Color="#CCE8FF"/>
    <SolidColorBrush x:Key="ListSelectedTextBrush" Color="#000000"/>
    <SolidColorBrush x:Key="ListSelectedHoverBrush" Color="#99D1FF"/>
    <SolidColorBrush x:Key="ProgressBgBrush" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#CDCDCD"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#A6A6A6"/>
    <SolidColorBrush x:Key="DropFillBrush" Color="#F7F7F7"/>
    <SolidColorBrush x:Key="DropStrokeBrush" Color="#ABADB3"/>
    <SolidColorBrush x:Key="SplitterBrush" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#6D6D6D"/>
    <DrawingBrush x:Key="CheckerBrush" TileMode="Tile"
                  Viewport="0,0,16,16" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#E1E1E1">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,16,16"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#F5F5F5">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,0,8,8"/>
                            <RectangleGeometry Rect="8,8,8,8"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
