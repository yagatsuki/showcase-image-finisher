<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark palette (navy, the theme chosen by the user). -->
    <SolidColorBrush x:Key="BgBrush" Color="#161E2E"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#1C2942"/>
    <SolidColorBrush x:Key="InputBrush" Color="#141F36"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#334155"/>
    <SolidColorBrush x:Key="TextBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="SubTextBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#2E7CF6"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4A90F8"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1F66D6"/>
    <SolidColorBrush x:Key="LogBrush" Color="#0B1220"/>
    <SolidColorBrush x:Key="LogTextBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#27395C"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#1A2745"/>
    <SolidColorBrush x:Key="ComboHoverBrush" Color="#1D2C49"/>
    <SolidColorBrush x:Key="HeaderBrush" Color="#22304D"/>
    <SolidColorBrush x:Key="HeaderTextBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="HeaderHoverBrush" Color="#2E4066"/>
    <SolidColorBrush x:Key="HeaderHoverTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderPressedBrush" Color="#1A2740"/>
    <SolidColorBrush x:Key="ListHoverBrush" Color="#26334D"/>
    <SolidColorBrush x:Key="ListSelectedBrush" Color="#2E4A73"/>
    <SolidColorBrush x:Key="ListSelectedTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ListSelectedHoverBrush" Color="#3A5C8C"/>
    <SolidColorBrush x:Key="ProgressBgBrush" Color="#263449"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#475569"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="DropFillBrush" Color="#1B2740"/>
    <SolidColorBrush x:Key="DropStrokeBrush" Color="#46618C"/>
    <SolidColorBrush x:Key="SplitterBrush" Color="#22304D"/>
    <DrawingBrush x:Key="CheckerBrush" TileMode="Tile"
                  Viewport="0,0,16,16" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#232F45">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,16,16"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#2E3D5C">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,0,8,8"/>
                            <RectangleGeometry Rect="8,8,8,8"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
