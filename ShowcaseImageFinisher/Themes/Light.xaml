<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light palette (white base with a blue accent). -->
    <SolidColorBrush x:Key="BgBrush" Color="#F3F5F9"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#C3CEDD"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1F2937"/>
    <SolidColorBrush x:Key="SubTextBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#2E7CF6"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4A90F8"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1F66D6"/>
    <SolidColorBrush x:Key="LogBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LogTextBrush" Color="#1F2937"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#E6EDF7"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#D5DFEF"/>
    <SolidColorBrush x:Key="ComboHoverBrush" Color="#EDF1F7"/>
    <SolidColorBrush x:Key="HeaderBrush" Color="#E7ECF3"/>
    <SolidColorBrush x:Key="HeaderTextBrush" Color="#334155"/>
    <SolidColorBrush x:Key="HeaderHoverBrush" Color="#D9E2EE"/>
    <SolidColorBrush x:Key="HeaderHoverTextBrush" Color="#111827"/>
    <SolidColorBrush x:Key="HeaderPressedBrush" Color="#C9D4E4"/>
    <SolidColorBrush x:Key="ListHoverBrush" Color="#E8EFF9"/>
    <SolidColorBrush x:Key="ListSelectedBrush" Color="#B9D4F6"/>
    <SolidColorBrush x:Key="ListSelectedTextBrush" Color="#10243E"/>
    <SolidColorBrush x:Key="ListSelectedHoverBrush" Color="#A8C8F2"/>
    <SolidColorBrush x:Key="ProgressBgBrush" Color="#DEE5EF"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#9AA9BE"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#71809A"/>
    <SolidColorBrush x:Key="DropFillBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DropStrokeBrush" Color="#8FA3BF"/>
    <SolidColorBrush x:Key="SplitterBrush" Color="#DDE3EC"/>
    <DrawingBrush x:Key="CheckerBrush" TileMode="Tile"
                  Viewport="0,0,16,16" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#D8DEE9">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,16,16"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#F2F5F9">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,0,8,8"/>
                            <RectangleGeometry Rect="8,8,8,8"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
